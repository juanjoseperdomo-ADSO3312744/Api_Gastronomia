    {
      "name": "01. Autenticación (RF01)",
      "item": [
        {
          "name": "Login - ADMIN (Guarda token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"token_admin\", jsonData.access_token);",
                  "pm.test(\"Token JWT recibido y rol ADMIN\", function () {",
                  "    pm.expect(jsonData.rol).to.eql(\"ADMIN\");",
                  "    pm.expect(jsonData.access_token).to.be.a('string');",
                  "});",
                  "pm.test(\"RN06: Contraseña no expuesta\", function () {",
                  "    pm.expect(jsonData.usuario.password).to.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@gastronomia.sena.edu.co\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
