            }
          }
        },
        {
          "name": "Calcular Costo y Margen de Producto (RF06)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"Verifica cálculo de margen = precio_venta - costo_produccion\", function () {",
                  "    var margenEsperado = Number((data.precio_venta - data.costo_produccion).toFixed(2));",
                  "    pm.expect(data.margen_ganancia).to.eql(margenEsperado);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cocinero}}",
                  "type": "string"
